# Optional - only needed for "Save & Share" links and the run log.
# Without it the tutorial + COBOL-only compiler still work fully
# (sharing endpoints return a friendly "sharing disabled" message).
DATABASE_URL=postgresql://user:password@localhost:5432/cobol

# Optional - enables AI line-by-line code explanations in the compiler and
# exercises (via Google Gemini). Without it, the built-in COBOL analyzer is
# used instead, so the Explain feature always works.
#   Get a free key: https://aistudio.google.com/app/apikey
#   On Vercel: Project -> Settings -> Environment Variables -> add GEMINI_API_KEY
GEMINI_API_KEY=
# Optional - override the model (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional - enables the Google-Docs-style collaboration (free tier):
# accounts, real-time multi-user editing, presence and comments.
#   1. Create a FREE project at https://supabase.com (no credit card needed)
#   2. Project Settings -> API: copy the Project URL and the anon public key
#   3. Run this SQL once in the SQL editor:
#        create table if not exists collab_documents (room text primary key, state text, updated_at timestamptz);
#        create table if not exists collab_comments  (id text primary key, room text, name text, emoji text, color text, body text, created_at timestamptz default now());
#        alter table collab_documents enable row level security;
#        alter table collab_comments  enable row level security;
#        create policy "collab all" on collab_documents for all using (true) with check (true);
#        create policy "collab all" on collab_comments  for all using (true) with check (true);
#   4. Authentication -> Providers: keep Email on, and turn OFF "Confirm email"
#      so sign-ups get a session instantly.
#   Without these the site works fully; Collaborate explains how to enable it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
