# Optional - only needed for "Save & Share" links and the run log.
# Without it the tutorial + COBOL-only compiler still work fully
# (sharing endpoints return a friendly "sharing disabled" message).
DATABASE_URL=postgresql://user:password@localhost:5432/cobol

# Optional - enables AI line-by-line code explanations in the compiler and
# exercises (via Google Gemini). Without it, the built-in COBOL analyzer is
# used instead, so the Explain feature always works.
#   Get a free key: https://aistudio.google.com/app/apikey
#   On Vercel: Project -> Settings -> Environment Variables -> add GEMINI_API_KEY
GEMINI_API_KEY=
# Optional - override the model (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
